# --- Server configuration ---
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# --- MOT API mode ---
# When true the server returns realistic fake MOT data and ignores credentials below.
# Set to false to use the real DVSA MOT History API (you must fill in the credentials).
DVSA_MOT_MOCK_MODE=true

# --- Real DVSA MOT History API (leave blank for mock mode) ---
# Apply for access at: https://documentation.history.mot.api.gov.uk/
DVSA_CLIENT_ID=
DVSA_CLIENT_SECRET=
DVSA_API_KEY=
DVSA_TOKEN_URL=https://login.microsoftonline.com/a455b827-244f-4c97-b5b4-ce5d13b4d00c/oauth2/v2.0/token
DVSA_SCOPE_URL=https://tapi.dvsa.gov.uk/.default
DVSA_LOOKUP_URL_TEMPLATE=https://history.mot.api.gov.uk/v1/trade/vehicles/registration/{registration}
