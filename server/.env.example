# Server config
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# MOT API mode
# When DVSA_MOT_MOCK_MODE=true the server returns realistic mock MOT data
# and never calls the real DVSA API. Set to false when you have valid
# DVSA credentials configured below.
DVSA_MOT_MOCK_MODE=true

# Real DVSA MOT History API credentials (leave blank for mock mode)
# See: https://documentation.history.mot.api.gov.uk/
DVSA_CLIENT_ID=
DVSA_CLIENT_SECRET=
DVSA_API_KEY=
DVSA_TOKEN_URL=
DVSA_SCOPE_URL=
# Use {registration} as the placeholder for the registration number
DVSA_LOOKUP_URL_TEMPLATE=
